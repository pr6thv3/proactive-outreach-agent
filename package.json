{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "worker": "tsx scripts/worker.ts",
    "dev:worker": "tsx watch scripts/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx src/__tests__/smoke.test.ts && tsx src/__tests__/architecture.test.ts && tsx src/__tests__/strategy.test.ts && tsx src/__tests__/risk.test.ts",
    "test:beta": "cross-env SQLITE_DATABASE_URL=file:./dev.db AUTH_DEV_BYPASS=true tsx src/__tests__/beta-contracts.test.ts",
    "test:all": "npm run test && npm run test:beta",
    "test:staging": "cross-env SQLITE_DATABASE_URL=file:./dev.db AUTH_DEV_BYPASS=true tsx src/__tests__/staging-acceptance.test.ts",
    "test:failure-qa": "cross-env SQLITE_DATABASE_URL=file:./dev.db AUTH_DEV_BYPASS=true tsx src/__tests__/failure-state-qa.test.ts",
    "test:hardening": "npm run test && npm run test:staging && npm run test:failure-qa",
    "smoke": "tsx src/__tests__/smoke.test.ts",
    "db:push": "node scripts/prisma-cli.mjs db push",
    "db:generate": "node scripts/prisma-cli.mjs generate",
    "db:validate": "node scripts/prisma-cli.mjs validate",
    "db:push:sqlite": "node scripts/prisma-cli.mjs db push --sqlite",
    "db:generate:sqlite": "node scripts/prisma-cli.mjs generate --sqlite",
    "db:validate:sqlite": "node scripts/prisma-cli.mjs validate --sqlite",
    "db:migrate": "node scripts/prisma-cli.mjs migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
