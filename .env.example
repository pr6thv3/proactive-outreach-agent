# ─── Database ────────────────────────────────────────────
# PostgreSQL is the production target. Use Neon, Supabase, RDS, or local Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proactive_outreach

# Optional local-only SQLite schema. Use npm run db:*:sqlite scripts.
SQLITE_DATABASE_URL=file:./dev.db

# ─── Redis / BullMQ ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Email Delivery (Resend) ────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# ─── Sending Domain Defaults ────────────────────────────
DEFAULT_SENDER_EMAIL=outreach@yourdomain.com
DEFAULT_SENDER_NAME=Alex from OutreachOS
DEFAULT_REPLY_TO=reply@yourdomain.com

# ─── Webhook Secrets ────────────────────────────────────
# Used to verify Resend webhook signatures
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ─── App URL ────────────────────────────────────────────
# Public URL of your app (used for unsubscribe links and tracking)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Authentication (Clerk) ─────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Local development only: bypass Clerk when keys are absent.
AUTH_DEV_BYPASS=true

# ─── AI / Embeddings ────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxx
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
