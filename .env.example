# ─── Database ────────────────────────────────────────────
# SQLite for development. Use PostgreSQL for production (Neon/Supabase).
DATABASE_URL=file:./db/custom.db

# ─── Email Delivery (Resend) ────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# ─── Sending Domain Defaults ────────────────────────────
DEFAULT_SENDER_EMAIL=outreach@yourdomain.com
DEFAULT_SENDER_NAME=Alex from OutreachOS
DEFAULT_REPLY_TO=reply@yourdomain.com

# ─── Webhook Secrets ────────────────────────────────────
# Used to verify Resend webhook signatures
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ─── App URL ────────────────────────────────────────────
# Public URL of your app (used for unsubscribe links and tracking)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Authentication (optional, for future use) ──────────
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-here
