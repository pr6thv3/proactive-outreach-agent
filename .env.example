# ==============================================================================
# ProactiveReach — Autonomous AI SDR Platform Environment Configuration
# ==============================================================================
# Copy this template to .env and adjust values for your environment.
# Run `npm run setup` (or `bash scripts/setup.sh`) to automatically configure
# local database, secrets, and environment prerequisites.
# ==============================================================================

# ─── 1. Database Configuration ────────────────────────────────────────────────
# REQUIRED for production. PostgreSQL (v14+) database connection string.
# Supports connection pooling (e.g. Supabase, Neon, AWS RDS, self-hosted Postgres).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proactive_outreach"

# OPTIONAL: Direct unpooled database connection URL (used by Prisma Migrate on pooled databases).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/proactive_outreach"

# OPTIONAL: Local SQLite database URL. Used when running in local/test mode (--sqlite flag).
# If set, Prisma client can operate against local SQLite without needing PostgreSQL running.
SQLITE_DATABASE_URL="file:./dev.db"

# ─── 2. Authentication (NextAuth.js v5) ────────────────────────────────────────
# REQUIRED in production. Secure secret used to sign session cookies and JWTs.
# Generate a new random secret with: `openssl rand -base64 32`
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars-long"

# Canonical URL of the application. In production, set to your custom domain (e.g. https://outreach.company.com).
# Defaults to http://localhost:3000 in development.
NEXTAUTH_URL="http://localhost:3000"

# OPTIONAL: Google OAuth 2.0 Provider Credentials (enables "Sign in with Google").
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID.
# Callback URL to register: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OPTIONAL: Local development bypass flag ('true' or 'false').
# When set to 'true', API routes and pages bypass authentication checks,
# mapping requests to a default local test organization and owner.
# MUST BE 'false' or unset in production!
AUTH_DEV_BYPASS="true"

# ─── 3. Redis & Queue Architecture ────────────────────────────────────────────
# REQUIRED in production for BullMQ background workers and asynchronous job processing.
# Format: redis://[username:password@]host:port[/db-number]
# Example: redis://localhost:6379 or rediss://default:token@my-redis.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# OPTIONAL: Upstash Redis REST API connection (used for distributed rate limiting & send counters).
# If unconfigured, the application gracefully falls back to local in-memory/database counters.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── 4. Email Delivery & Inbound Webhooks (Resend) ────────────────────────────
# OPTIONAL in local dev (sends run in local simulation mode with providerId='local_only').
# REQUIRED for live outbound email sending. Obtain from https://resend.com/api-keys
RESEND_API_KEY=""

# REQUIRED in production when receiving bounce and delivery webhooks from Resend.
# Endpoint to configure in Resend: https://<your-domain>/api/webhooks/resend
# Copy the signing secret starting with 'whsec_'
RESEND_WEBHOOK_SECRET=""

# Default sender identity. For sandbox testing, Resend allows 'onboarding@resend.dev'
# sending strictly to your account owner email. For live outbound sales,
# configure a verified custom domain (e.g. 'alex@outbound.yourdomain.com').
DEFAULT_SENDER_EMAIL="onboarding@resend.dev"
DEFAULT_SENDER_NAME="Alex from ProactiveReach"
DEFAULT_REPLY_TO="onboarding@resend.dev"

# ─── 5. Security & Admin Keys ─────────────────────────────────────────────────
# Bearer secret for securing automated scheduled jobs and Vercel Cron routes.
# Must match the Authorization header passed by your cron runner or Vercel cron.
CRON_SECRET="your-secure-cron-secret-token"

# Platform Superadmin Secret keys (optional; grants administrative bypass when provided in X-Platform-Admin-Secret header).
PLATFORM_ADMIN_SECRET=""
ADMIN_SECRET=""

# ─── 6. AI / LLM Reasoning & Strategy ─────────────────────────────────────────
# OpenAI API key for AI SDR autonomous message personalization, intent analysis, and ICP generation.
# If omitted or unavailable, the agent gracefully degrades to deterministic rule-based copy templates.
OPENAI_API_KEY=""

# Embedding provider and model configuration for semantic lead and signal matching.
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"

# ─── 7. Application URL & Observability ───────────────────────────────────────
# Public URL of the frontend application (used in emails and webhook links).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# OPTIONAL: Sentry DSN for error monitoring and stack trace capturing.
SENTRY_DSN=""
