// ─── Prisma Schema for ProactiveReach SaaS ──────────────
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum EnrichmentStatus {
  PENDING
  MX_VERIFIED
  REGEX_FAILED
  MX_FAILED
  ENRICHED
  BOUNCED
  SKIPPED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CampaignLeadStatus {
  ENROLLED
  ACTIVE
  REPLIED
  UNSUBSCRIBED
  BOUNCED
  COMPLETED
}

enum OutreachEmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  FAILED
}

enum EmailGeneratedBy {
  AI
  HUMAN
}

enum DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  SUSPENDED
}

enum WebhookStatus {
  ACTIVE
  INACTIVE
}

// ─── MULTI-TENANCY ROOT ──────────────────────────────────
model Organization {
  id                 String             @id @default(cuid())
  workspaceKey       String             @unique @default(cuid())
  name               String
  slug               String?            @unique
  plan               String             @default("free")
  subscriptionStatus String             @default("active")
  billingCustomerId  String?

  members             OrganizationMember[]
  userPreferences     UserPreference[]
  icpCriteria         IcpCriteria[]
  leads               Lead[]
  signals             Signal[]
  enrichmentQueues    EnrichmentQueue[]
  campaigns           Campaign[]
  campaignLeads       CampaignLead[]
  outreachEmails      OutreachEmail[]
  sendingDomains      SendingDomain[]
  auditLogs           AuditLog[]
  webhookEndpoints    WebhookEndpoint[]
  apiKeys             ApiKey[]
  
  // Legacy / Complementary
  doNotContact        DoNotContact[]
  activities          Activity[]
  pipelineRuns        PipelineRun[]
  agentMemory         AgentMemory[]
  jobRecords          JobQueue[]
  emailEvents         EmailEvent[]
  followUps           FollowUp[]
  replyClassifications ReplyClassification[]
  messageEdits        MessageEdit[]
  agentEvents         AgentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── AUTHENTICATION & USERS ──────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  isSuperAdmin  Boolean   @default(false)
  
  memberships   OrganizationMember[]
  preferences   UserPreference?
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
}

model UserPreference {
  id                 String       @id @default(cuid())
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrgId        String?
  organization       Organization? @relation(fields: [activeOrgId], references: [id], onDelete: SetNull)
  onboardingStep     Int          @default(1)
  onboardingComplete Boolean      @default(false)
  autonomyEnabled    Boolean      @default(true)
  autonomyPaused     Boolean      @default(false)
  minLeadScore       Float        @default(60.0)
  dailySendLimit     Int          @default(50)
  pausedReason       String?
  pausedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([activeOrgId])
}

// ─── ICP CRITERIA ────────────────────────────────────────
model IcpCriteria {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  industries       String[]     @default([])
  companySizeMin   Int?         @default(10)
  companySizeMax   Int?         @default(500)
  revenueMin       Float?
  revenueMax       Float?
  techStack        String[]     @default([])
  excludeTechStack String[]     @default([])
  requiredSignals  String[]     @default([])
  minSignalScore   Float        @default(50.0)
  valueProp        String?
  painPoints       String[]     @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// ─── LEADS & SIGNALS ─────────────────────────────────────
model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String?
  lastName       String?
  name           String
  email          String
  industry       String?
  companySize    String?
  country        String?
  url            String?
  company        String?
  title          String?
  linkedinUrl    String?
  website        String?
  enrichedData   Json?
  score          Float        @default(0.0)
  leadScore      Float?       @default(0.0)
  signalScore    Float?       @default(0.0)
  priorityTier   String?      @default("warm")
  replyProb      Float?       @default(0.3)
  conversionProb Float?       @default(0.1)
  spamRisk       Float?       @default(0.05)
  status         String       @default("new")
  source         String       @default("manual")
  emailVerified  Boolean      @default(false)
  isBlacklisted  Boolean      @default(false)
  doNotContact   Boolean      @default(false)
  lastContacted  DateTime?

  signals          Signal[]
  enrichmentQueues EnrichmentQueue[]
  campaignLeads    CampaignLead[]
  outreachEmails   OutreachEmail[]
  activities       Activity[]
  agentMemories    AgentMemory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, score])
  @@index([organizationId, status])
  @@index([email])
  @@index([company])
}

model Signal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type           String
  content        String
  source         String       @default("agent")
  sourceUrl      String?
  sourceTitle    String?
  rawData        Json?
  score          Float        @default(50.0)
  relevance      Float        @default(0.5)
  confidence     Float        @default(0.5)
  urgency        Float?       @default(0.5)
  reasoning      String?
  recommendedPitchAngle String?
  recommendedOffer      String?
  decayRate      Float?       @default(0.02)
  observedAt     DateTime     @default(now())
  detectedAt     DateTime?
  expiresAt      DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([leadId])
  @@index([organizationId, type])
  @@index([organizationId, score])
}

model EnrichmentQueue {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  email          String
  status         EnrichmentStatus @default(PENDING)
  mxValid        Boolean          @default(false)
  provider       String?          @default("dns_mx")
  providerData   Json?
  retryCount     Int              @default(0)
  nextRetryAt    DateTime?
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([leadId])
  @@index([organizationId, status])
  @@index([email])
}

// ─── CAMPAIGNS & OUTREACH ────────────────────────────────
model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  status         String         @default("DRAFT")
  sequenceSteps  Json?
  fromEmail      String?
  fromName       String?
  dailyLimit     Int            @default(50)
  startedAt      DateTime?
  pausedAt       DateTime?

  goal                           String?
  targetAudience                 String?
  offer                          String?
  senderEmail                    String?
  senderName                     String?
  tone                           String?         @default("professional")
  cta                            String?
  maxDailySends                  Int?            @default(50)
  followUpSchedule               String?
  productDescription             String?
  dailySendsCount                Int?            @default(0)
  dailySendsDate                 DateTime?
  channels                       String?         @default("[\"email\"]")
  linkedinEnabled                Boolean?        @default(false)
  twitterEnabled                 Boolean?        @default(false)
  smsEnabled                     Boolean?        @default(false)
  contactFormEnabled             Boolean?        @default(false)
  autonomyEnabled                Boolean?        @default(false)
  autonomyMinScore               Float?          @default(60.0)
  autonomyMaxDailyActions        Int?            @default(20)
  autonomyActionsToday           Int?            @default(0)
  autoApprovalEnabled            Boolean?        @default(false)
  spamRiskThreshold              Float?          @default(0.25)
  bounceRatePauseThreshold       Float?          @default(0.03)
  complaintRatePauseThreshold    Float?          @default(0.001)
  unsubscribeRatePauseThreshold  Float?          @default(0.02)
  pausedReason                   String?

  campaignLeads  CampaignLead[]
  outreachEmails OutreachEmail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
}

model CampaignLead {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  currentStep    Int                @default(1)
  status         CampaignLeadStatus @default(ENROLLED)
  enrolledAt     DateTime           @default(now())
  nextStepAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, leadId])
  @@index([organizationId])
  @@index([leadId])
  @@index([campaignId])
  @@index([organizationId, status])
}

model OutreachEmail {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  senderId        String?
  subject         String
  body            String
  channel         String              @default("email")
  status          String              @default("QUEUED")
  approvedAt      DateTime?
  approvedBy      String?
  sentAt          DateTime?
  bouncedAt       DateTime?
  openedAt        DateTime?
  repliedAt       DateTime?
  unsubFooter     String?
  resendMessageId String?
  generatedBy     EmailGeneratedBy    @default(AI)
  sequencePos     Int?                @default(0)
  signalTypeUsed  String?
  urgencyAtGeneration Float?
  pitchAngleUsed  String?
  evidenceSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([leadId])
  @@index([campaignId])
  @@index([organizationId, status])
  @@index([resendMessageId])
}

// ─── DELIVERABILITY & DOMAINS ─────────────────────────────
model SendingDomain {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain           String
  dkimVerified     Boolean      @default(false)
  spfVerified      Boolean      @default(false)
  dmarcVerified    Boolean      @default(false)
  warmupStartedAt  DateTime?
  dailyLimit       Int          @default(50)
  currentWarmupDay Int          @default(1)
  status           String       @default("PENDING")
  provider         String?      @default("resend")
  fromEmail        String?
  fromName         String?
  replyTo          String?
  apiKeyRef        String?
  resendDomainId   String?
  warmupEnabled    Boolean?     @default(true)
  warmupDay        Int?         @default(0)
  warmupDailyLimit Int?         @default(5)
  spfRecord        Json?
  spfStatus        String?      @default("pending")
  dkimRecord       Json?
  dkimStatus       String?      @default("pending")
  dmarcRecord      Json?
  dmarcStatus      String?      @default("pending")
  bounceRate       Float?       @default(0.0)
  complaintRate    Float?       @default(0.0)
  openRate         Float?       @default(0.0)
  clickRate        Float?       @default(0.0)
  reputationScore  Float?       @default(90.0)
  lastSentAt       DateTime?
  lastDnsCheckAt   DateTime?
  verifiedAt       DateTime?
  lastVerifiedAt   DateTime?
  dailySendsCount  Int?         @default(0)
  dailySendsDate   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, domain])
  @@index([organizationId])
  @@index([domain])
  @@index([organizationId, status])
}

// ─── AUDIT LOGGING, API KEYS, WEBHOOKS ───────────────────
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, action])
  @@index([userId])
  @@index([createdAt])
}

model WebhookEndpoint {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  events         String[]      @default([])
  secret         String
  status         WebhookStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyHash        String       @unique
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  scopes         String[]     @default(["read", "write"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([keyHash])
}

// ─── COMPLEMENTARY MODELS ─────────────────────────────────
model DoNotContact {
  id             String       @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  reason         String?
  source         String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type           String
  description    String
  metadata       String?
  phase          String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([leadId])
}

model PipelineRun {
  id             String       @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  agentName      String?
  phase          String
  status         String       @default("running")
  input          String?
  output         String?
  error          String?
  durationMs     Int?
  traceId        String?
  logs           String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([organizationId])
  @@index([phase])
}

model AgentMemory {
  id             String       @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  category       String
  key            String
  value          String
  score          Float        @default(0.5)
  embedding      Unsupported("vector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([category])
}

model JobQueue {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  queueName      String?       @default("default")
  type           String
  status         String        @default("pending")
  priority       Int           @default(5)
  payload        String
  result         String?
  error          String?
  retryCount     Int           @default(0)
  maxRetries     Int           @default(3)
  leadId         String?
  campaignId     String?
  traceId        String?
  scheduledAt    DateTime      @default(now())
  startedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([status])
}

model EmailEvent {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerId     String?
  recipient      String?
  type           String?
  eventType      String?
  bounceType     String?
  bounceReason   String?
  complaintType  String?
  clickUrl       String?
  messageId      String?
  leadId         String?
  campaignId     String?
  domainId       String?
  rawData        String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([messageId])
  @@index([leadId])
  @@index([campaignId])
  @@index([domainId])
  @@index([eventType])
  @@index([type])
  @@index([recipient])
  @@index([createdAt])
}

model FollowUp {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageId      String?
  leadId         String?
  campaignId     String?
  stepNumber     Int?
  scheduledAt    DateTime
  status         String        @default("scheduled")
  type           String        @default("reminder")
  sequencePos    Int           @default(1)
  subject        String?
  body           String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([campaignId])
  @@index([leadId])
  @@index([messageId])
  @@index([status])
  @@index([scheduledAt])
}

model ReplyClassification {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageId      String?
  leadId         String?
  category       String
  confidence     Float         @default(0.5)
  sentiment      String?
  reasoning      String?
  replyText      String?
  nextAction     String?
  actionTaken    String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([messageId])
  @@index([leadId])
  @@index([category])
}

model MessageEdit {
  id                  String        @id @default(cuid())
  organizationId      String?
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageId           String
  editType            String?
  fieldName           String?
  originalValue       String?
  editedValue         String?
  originalContent     String?
  editedContent       String?
  editRatio           Float?
  changeMagnitude     Float         @default(0.0)
  addedWords          Int           @default(0)
  removedWords        Int           @default(0)
  keptPhrases         String?
  signalTypeUsed      String?
  pitchAngleUsed      String?
  urgencyAtGeneration Float?
  leadId              String?
  campaignId          String?
  fedToMemory         Boolean       @default(false)
  outcomeAfterEdit    String?
  createdAt           DateTime      @default(now())

  @@index([organizationId])
  @@index([messageId])
  @@index([leadId])
  @@index([campaignId])
  @@index([editType])
  @@index([createdAt])
}

model AgentEvent {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipelineRunId  String?
  leadId         String?
  campaignId     String?
  agentName      String
  stepName       String?
  phase          String?
  level          String        @default("info")
  message        String?
  inputData      Json?
  outputData     Json?
  status         String?
  traceId        String?
  durationMs     Int?
  metadata       Json?
  error          String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([pipelineRunId])
  @@index([leadId])
  @@index([campaignId])
  @@index([traceId])
  @@index([phase])
  @@index([createdAt])
}

